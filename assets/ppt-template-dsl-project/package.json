{
  "name": "ppt-template-dsl",
  "version": "0.3.0",
  "description": "Template-bound PowerPoint generation from speaker-notes DSL annotations.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "analyze": "tsx src/analyze-template.ts",
    "generate": "tsx src/generate-deck.ts",
    "validate-input": "tsx src/validate-deck-input.ts",
    "lint-template": "tsx src/lint-template.ts",
    "qa": "tsx src/qa-deck.ts",
